          <zone friendly-name='Tools Used' h='31813' id='12' param='horz' type-v2='layout-flow' w='33731' x='34886' y='30819'>
            <zone forceUpdate='true' h='31577' id='36' type-v2='text' w='33625' x='34939' y='30937'>
              <formatted-text>
                <run bold='true' fontalignment='1' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='12'>🛠️ Tools &amp; Technologies Used</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='12'>📊</run>
                <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Æ </run>
