          <zone h='19442' id='24' param='horz' type-v2='layout-flow' w='17260' x='424' y='11377'>
            <zone h='19442' id='27' is-scaled='1' param='C:/Users/HP/Downloads/WhatsApp Image 2026-07-31 at 2.52.08 PM.jpeg' type-v2='bitmap' w='17260' x='424' y='11377'>
              <zone-style>
                <format attr='border-color' value='#2c3e5a' />
                <format attr='border-style' value='solid' />
