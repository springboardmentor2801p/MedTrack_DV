                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>✔ </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Patient Admissions</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>✔ </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Severe Cases %</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>✔ </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Department Performance</run>
