    <worksheet name='Bed Utilization Analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='dashboard_data' name='federated.1jb8hnb13bllac13edt200tralv0' />
          </datasources>
          <datasource-dependencies datasource='federated.1jb8hnb13bllac13edt200tralv0'>
            <column caption='occupancy rate' datatype='real' name='[Calculation_0437357789904899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Occupied_Beds]) / SUM([Total_Beds])' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Occupied Beds' datatype='integer' name='[Occupied_Beds]' role='measure' type='quantitative' />
            <column caption='Total Beds' datatype='integer' name='[Total_Beds]' role='measure' type='quantitative' />
