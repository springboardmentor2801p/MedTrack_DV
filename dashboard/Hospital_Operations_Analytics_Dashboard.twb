      <aliases enabled='yes' />
      <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='quantitative' />
      <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Ambulances]' role='measure' type='quantitative' />
      <column caption='Available Beds' datatype='integer' name='[Available_Beds]' role='measure' type='quantitative' />
      <column caption='Bill Amount' datatype='integer' name='[Bill_Amount]' role='measure' type='quantitative' />
      <column caption='Occupancy Trend' datatype='real' name='[Calculation_0437357789175810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Occupied_Beds]) / SUM([Total_Beds]) * 100' />
      </column>
      <column caption='occupancy rate' datatype='real' name='[Calculation_0437357789904899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Occupied_Beds]) / SUM([Total_Beds])' />
      </column>
      <column caption='Readmission Rate' datatype='real' name='[Calculation_0437357793632260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Readmission] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/COUNT([Patient_ID])' />
      </column>
      <column caption='total beds kpi' datatype='integer' name='[Calculation_0513781913325568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Available_Beds]) + SUM([Occupied_Beds])' />
      </column>
      <column caption='occupancy rate kpi' datatype='real' name='[Calculation_0513781914480642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Occupied_Beds])&#13;&#10;/&#13;&#10;(&#13;&#10;    SUM([Available_Beds])&#13;&#10;    + SUM([Occupied_Beds])&#13;&#10;)' />
      </column>
      <column caption='Discharge Count' datatype='integer' name='[Calculation_0882940851904512]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([Discharge_Date])&#13;&#10;    THEN [Patient_ID]&#13;&#10;    END&#13;&#10;)' />
