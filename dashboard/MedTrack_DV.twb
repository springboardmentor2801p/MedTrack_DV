                <zone forceUpdate='true' h='19442' id='28' type-v2='text' w='46166' x='17684' y='11377'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='15'>🏥 </run>
                    <run bold='true' fontalignment='1' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='15'>Project Overview</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>MedTrack DV is an interactive healthcare analytics dashboard designed to monitor hospital performance, patient flow, department efficiency, and resource utilization. It transforms raw hospital data into meaningful visual insights through interactive dashboards and key performance indicators (KPIs).</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>The solution enables hospital administrators and healthcare professionals to analyze admissions, occupancy, patient movement, billing, and clinical performance, supporting faster, data-driven decision-making and improved operational efficiency.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#2c3e5a' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='19442' id='31' type-v2='text' w='35726' x='63850' y='11377'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Benton Sans Book'>🎯 </run>
                    <run bold='true' fontalignment='1' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='15'>Project Objectives</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='10'>✓ </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'>Monitor hospital operations and performance using interactive dashboards</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='10'>✓</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'> Analyze patient flow, admissions, and discharge patterns</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='10'>✓</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'> Evaluate department performance and resource utilization</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='10'>✓</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='10'> Track key healthcare KPIs to support data-driven decision making.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#2c3e5a' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='31813' id='33' type-v2='text' w='34462' x='424' y='30819'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI Semibold' fontsize='12'>🏥 </run>
                    <run bold='true' fontalignment='1' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='12'>Dashboards Included:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>🏥 </run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>Hospital Overview:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Provides a comprehensive overview of hospital performance, operational KPIs, patient admissions, billing, occupancy, and readmission trends.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>👥 </run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>Patient Flow:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Analyzes patient admissions, discharge patterns, length of stay, severity levels, and patient movement across departments.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>🏢 </run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>Department Analytics:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Evaluates department performance through patient volume, treatment efficiency, readmission rates, and operational comparisons.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>⚙️ </run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>Resource Utilization:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'>Monitors hospital resource usage including bed occupancy, equipment utilization, staff allocation, and capacity management.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#2c3e5a' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='31813' id='37' type-v2='text' w='30959' x='68617' y='30819'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#10eee7' fontname='Segoe UI Semibold' fontsize='12'>📊 Key Performance Indicators</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>✔</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Segoe UI Semibold'> Total Patients</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#10eee7' fontname='Segoe UI Semibold'>✔ </run>
