              <calculation class='tableau' formula='SUM(&#13;&#10;IF [Severity] = &quot;Severe&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNTD([Patient_ID])' />
