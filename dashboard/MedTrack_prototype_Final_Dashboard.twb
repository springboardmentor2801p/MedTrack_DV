    <worksheet name='Department Metric Analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='hospital_final_dataset' name='federated.0geawfg0ow845a10ro1qb1b0lqa6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Department Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Revenue&quot;'>
              <calculation class='tableau' formula='&quot;Revenue&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0geawfg0ow845a10ro1qb1b0lqa6'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Admission ID' datatype='string' name='[Admission_ID]' role='dimension' type='nominal' />
            <column caption='Admission Type' datatype='string' name='[Admission_Type]' role='dimension' type='nominal' />
            <column caption='Selected Department Metric' datatype='real' name='[Calculation_1877449171562500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;Admissions&quot; THEN COUNT([Admission_ID])&#13;&#10;&#13;&#10;WHEN &quot;Revenue&quot; THEN SUM([Total_Revenue_INR])&#13;&#10;&#13;&#10;WHEN &quot;Occupancy&quot; THEN AVG([Occupancy_Rate_%])&#13;&#10;&#13;&#10;WHEN &quot;Efficiency&quot; THEN AVG([Department_Efficiency_Score])&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Department Efficiency Score' datatype='real' name='[Department_Efficiency_Score]' role='measure' type='quantitative' />
            <column caption='Occupancy Rate %' datatype='real' name='[Occupancy_Rate_%]' role='measure' type='quantitative' />
            <column caption='Total Revenue INR' datatype='integer' name='[Total_Revenue_INR]' role='measure' type='quantitative' />
            <column-instance column='[Admission_Date]' derivation='Month' name='[mn:Admission_Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Admission_Date]' derivation='None' name='[none:Admission_Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Admission_Type]' derivation='None' name='[none:Admission_Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Department]' derivation='None' name='[none:Department:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1877449171562500]' derivation='User' name='[usr:Calculation_1877449171562500:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Admission_Date]' derivation='Year' name='[yr:Admission_Date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <computed-sort column='[federated.0geawfg0ow845a10ro1qb1b0lqa6].[none:Department:nk]' direction='DESC' using='[federated.0geawfg0ow845a10ro1qb1b0lqa6].[usr:Calculation_1877449171562500:qk]' />
          <slices>
            <column>[federated.0geawfg0ow845a10ro1qb1b0lqa6].[none:Admission_Date:qk]</column>
            <column>[federated.0geawfg0ow845a10ro1qb1b0lqa6].[none:Department:nk]</column>
