      <column caption='Short Stay %' datatype='real' default-format='p0.00%' name='[Calculation_0512948502867968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [stay_category] = &quot;Short Stay&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([admission_id])' />
      </column>
      <column caption='Planned Bed Capacity' datatype='real' name='[Calculation_0722686454947846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#13;&#10;    [Calculation_1912352210567168] * (1 + [Parameters].[Parameter 0722686454718469] / 100)&#13;&#10;)' />
      </column>
      <column caption='Readmission by Department' datatype='integer' name='[Calculation_1029449031376896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Department_Efficiency_Score] &gt;= 1700 THEN 45&#13;&#10;ELSEIF [Department_Efficiency_Score] &gt;= 1500 THEN 50&#13;&#10;ELSEIF [Department_Efficiency_Score] &gt;= 1300 THEN 55&#13;&#10;ELSE 60&#13;&#10;END' />
      </column>
      <column caption='Top Performing Department' datatype='string' name='[Calculation_1029449058111489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Department_Efficiency_Score] =&#13;&#10;{ FIXED : MAX([Department_Efficiency_Score]) }&#13;&#10;THEN [department_name]&#13;&#10;END' />
      </column>
      <column caption='Average Revenue per Department' datatype='real' name='[Calculation_1029449106378754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([department_revenue]) / COUNTD([department_name])' />
