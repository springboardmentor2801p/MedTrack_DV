            <column caption='Total Beds' datatype='integer' name='[Total_Beds]' role='measure' type='quantitative' />
            <column-instance column='[Admission_Date]' derivation='Month-Trunc' name='[tmn:Admission_Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0437357789904899]' derivation='User' name='[usr:Calculation_0437357789904899:qk]' pivot='key' type='quantitative' />
