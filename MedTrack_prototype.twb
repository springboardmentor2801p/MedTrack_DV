      <aliases enabled='yes' />
      <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
      <column caption='Admission ID' datatype='string' name='[Admission_ID]' role='dimension' type='nominal' />
      <column caption='Admission Type' datatype='string' name='[Admission_Type]' role='dimension' type='nominal' />
      <column caption='Attending Doctor' datatype='string' name='[Attending_Doctor]' role='dimension' type='nominal' />
      <column caption='Available Beds' datatype='integer' name='[Available_Beds]' role='measure' type='quantitative' />
      <column caption='Bed Utilization Rate' datatype='real' name='[Bed_Utilization_Rate]' role='measure' type='quantitative' />
      <column caption='Bill Amount INR' datatype='integer' name='[Bill_Amount_INR]' role='measure' type='quantitative' />
      <column caption='Total Admissions' datatype='integer' name='[Calculation_0183644385746944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Admission_ID])' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_0183644386230274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Revenue_INR])' />
      </column>
      <column caption='Average Occupancy' datatype='real' name='[Calculation_0183644386471939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Occupancy_Rate_%])' />
