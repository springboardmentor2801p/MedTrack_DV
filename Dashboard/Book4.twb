      <aliases enabled='yes' />
      <column caption='Occupancy Status' datatype='string' name='[Calculation_0260886862131200]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([occupancy_rate]) &gt; 90 THEN&#13;&#10;    &quot;Good&quot;&#13;&#10;ELSEIF SUM([occupancy_rate]) &gt;= 80 THEN&#13;&#10;    &quot;Average&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept. efficiency status' datatype='string' name='[Calculation_0260886863007745]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([department_efficiency_score]) &gt;= 80 THEN&#13;&#10;    &quot;Excellent&quot;&#13;&#10;ELSEIF SUM([department_efficiency_score]) &gt;= 60 THEN&#13;&#10;    &quot;Average&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Bed utilization Status' datatype='string' name='[Calculation_0260886863499266]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([bed_utilization_rate]) &gt;= 70 THEN&#13;&#10;    &quot;Excellent&quot;&#13;&#10;ELSEIF SUM([bed_utilization_rate]) &gt;= 50 THEN&#13;&#10;    &quot;Average&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='LOS Status' datatype='string' name='[Calculation_0260886863884292]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([average_length_of_stay]) &lt;= 5 THEN&#13;&#10;    &quot;Excellent&quot;&#13;&#10;ELSEIF SUM([average_length_of_stay]) &lt;= 8 THEN&#13;&#10;    &quot;Average&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Readmission Status' datatype='string' name='[Calculation_0260886864084997]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([readmission_rate]) &lt;= 10 THEN&#13;&#10;    &quot;Excellent&quot;&#13;&#10;ELSEIF SUM([readmission_rate]) &lt;= 20 THEN&#13;&#10;    &quot;Average&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Progress' datatype='real' name='[Calculation_0302672148377600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([bed_utilization_rate])' />
      </column>
      <column caption='Maximum' datatype='integer' name='[Calculation_0302672148553729]' role='measure' type='quantitative'>
