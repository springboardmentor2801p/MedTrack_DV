      </column>
      <column caption='Target Occupancy' datatype='integer' name='[Calculation_0620705610399744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='85' />
      </column>
      <column caption='Current Value' datatype='real' name='[Calculation_0620705675026433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([bed_utilization_rate])' />
      </column>
      <column caption='Remaining Value' datatype='real' name='[Calculation_0620705675304962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 - AVG([bed_utilization_rate])' />
