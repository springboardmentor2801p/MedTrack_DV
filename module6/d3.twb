      <column caption='Admission Date' datatype='string' name='[Admission_Date]' role='dimension' type='nominal' />
      <column caption='Admission Month' datatype='string' name='[Admission_Month]' role='dimension' type='nominal' />
      <column caption='Available Beds' datatype='integer' name='[Available_Beds]' role='measure' type='quantitative' />
      <column caption='Bed Cnt' datatype='integer' name='[BED_CNT]' role='measure' type='quantitative' />
      <column caption='Bed Utilization Rate' datatype='real' name='[Bed_Utilization_Rate]' role='measure' type='quantitative' />
      <column caption='Bed Utilization KPI' datatype='real' name='[Calculation_0710042659356672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Bed_Utilization_Rate]) / 100' />
      </column>
      <column caption='Bed Utilization KPI1' datatype='real' name='[Calculation_0710042659483650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Bed_Utilization_Rate]) / 100' />
      </column>
      <column caption='Hospital Bed Utilization' datatype='real' name='[Calculation_0710042666979332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Occupied_Beds]) /&#13;&#10;(SUM([Occupied_Beds]) + SUM([Available_Beds]))' />
      </column>
      <column caption='Hospital Rating Numeric' datatype='integer' name='[Calculation_0741651230441472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Hospital overall rating] = &quot;Not Available&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    INT([Hospital overall rating])&#13;&#10;END' />
      </column>
      <column caption='Readmission Rate' datatype='real' default-format='p0.00%' name='[Calculation_2200151228817408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [readmitted] &lt;&gt; &quot;NO&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([encounter_id])' />
      </column>
